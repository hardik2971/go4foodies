APP_NAME="Go4Foodie Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Business local time — same as the Next.js admin server (this PC: Asia/Kolkata).
APP_LOCAL_TIMEZONE=Asia/Kolkata
APP_URL=http://192.168.1.44:33665

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=10
# bcryptjs hashes ($2b$) from the Next.js admin are valid bcrypt but PHP reports them as unknown — skip the algorithm check.
HASH_VERIFY=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ----- Shared MySQL (same restaurant_db as the Next.js admin) -----
# Dev PC: via the SSH tunnel on 33663 (start it with: cd ../admin && npm run tunnel).
# Server: DB_PORT=3306. NEVER run php artisan migrate against this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33663
DB_DATABASE=restaurant_db
DB_USERNAME=root
DB_PASSWORD=

# No framework tables in the shared DB — file-based session/cache, sync queue.
SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ----- Mobile app JWT: same secret as the Next.js admin so tokens work on both -----
AUTH_SECRET=

# Public website (table QR codes encode <WEBSITE_URL>/order?table=<code>)
WEBSITE_URL=http://192.168.1.44:20133

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hrsanghani2971@gmail.com
MAIL_FROM_NAME="Go4Foodie"

VITE_APP_NAME="${APP_NAME}"
